! X colors.
! Generated by 'wal'
*foreground:        #c6c5c2
*background:        #1e180c
*.foreground:       #c6c5c2
*.background:       #1e180c
emacs*foreground:   #c6c5c2
emacs*background:   #1e180c
URxvt*foreground:   #c6c5c2
XTerm*foreground:   #c6c5c2
UXTerm*foreground:  #c6c5c2
URxvt*background:   [100]#1e180c
XTerm*background:   #1e180c
UXTerm*background:  #1e180c
URxvt*cursorColor:  #c6c5c2
XTerm*cursorColor:  #c6c5c2
UXTerm*cursorColor: #c6c5c2
URxvt*borderColor:  [100]#1e180c

! Colors 0-15.
*.color0: #1e180c
*color0:  #1e180c
*.color1: #715543
*color1:  #715543
*.color2: #9A5831
*color2:  #9A5831
*.color3: #B3562A
*color3:  #B3562A
*.color4: #9D6B47
*color4:  #9D6B47
*.color5: #DEA862
*color5:  #DEA862
*.color6: #DBAD67
*color6:  #DBAD67
*.color7: #c6c5c2
*color7:  #c6c5c2
*.color8: #70695c
*color8:  #70695c
*.color9: #715543
*color9:  #715543
*.color10: #9A5831
*color10:  #9A5831
*.color11: #B3562A
*color11:  #B3562A
*.color12: #9D6B47
*color12:  #9D6B47
*.color13: #DEA862
*color13:  #DEA862
*.color14: #DBAD67
*color14:  #DBAD67
*.color15: #c6c5c2
*color15:  #c6c5c2

! Black color that will not be affected by bold highlighting.
*.color66: #1e180c
*color66:  #1e180c

! Xclock colors.
XClock*foreground: #c6c5c2
XClock*background: #1e180c
XClock*majorColor:  rgba:c6/c5/c2/ff
XClock*minorColor:  rgba:c6/c5/c2/ff
XClock*hourColor:   rgba:c6/c5/c2/ff
XClock*minuteColor: rgba:c6/c5/c2/ff
XClock*secondColor: rgba:c6/c5/c2/ff

! Set depth to make transparency work.
URxvt*depth: 32
