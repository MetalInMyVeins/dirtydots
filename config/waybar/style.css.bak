* {
    /* `otf-font-awesome` is required to be installed for icons */
    /*font-family: Ubuntu, FontAwesome, Roboto, Helvetica, Arial, sans-serif;*/
    font-family: Ubuntu;
    font-size: 13px;
    padding: 0;
    margin: 0;
}

window#waybar {
    background-color: rgba(43, 48, 59, 0);
    color: #ffffff;
    transition-property: background-color;
    transition-duration: .5s;
    font-weight: bolder;
}
window#waybar.hidden {
    opacity: 0.2;
}


button {
    box-shadow: inset 0 -3px transparent;
    border: none;
    border-radius: 0;
}
button:hover {
    background: inherit;
    color: #ff0000;
}


#workspaces button {
    padding: 0 5px;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(53, 132, 228, 0.4);
    font-weight: bolder;
    border-radius: 10px;
}
#workspaces button:hover {
    background: rgba(53, 132, 228, 0.6);
}
#workspaces button.active {
    color: rgba(53, 132, 228, 1);
}
#workspaces button.urgent {
    background-color: #eb4d4b;
    color: #0000ff;
}


#window,
#workspaces {
    font-family: Ubuntu;
    font-weight: bolder;
    background-color: rgba(0, 0, 0, 0.5);
    color: rgba(53, 132, 228, 0.8);
    border: 2px solid rgba(53, 132, 228, 0.8);
    border-radius: 10px;
}

.modules-left > widget:first-child > #workspaces {
    margin-left: 0;
}

.modules-right > widget:last-child > #workspaces {
    margin-right: 0;
}


#battery {
    font-weight: bolder;
    background-color: rgba(0, 0, 0, 0.5);
    color: rgba(53, 132, 228, 0.8);
    border: 2px solid rgba(53, 132, 228, 0.8);
    border-radius: 10px;
}
#battery.charging, #battery.plugged {
    font-weight: bolder;
    background-color: rgba(0, 0, 0, 0.5);
    color: rgba(53, 132, 228, 0.8);
    border: 2px solid rgba(53, 132, 228, 0.8);
    border-radius: 10px;
}
@keyframes blink {
    to {
      font-weight: bolder;
      background-color: rgba(0, 0, 0, 0.5);
      color: rgba(53, 132, 228, 0.8);
      border: 2px solid rgba(53, 132, 228, 0.8);
      border-radius: 10px;
    }
}
#battery.critical:not(.charging) {
    font-weight: bolder;
    background-color: rgba(0, 0, 0, 0.5);
    color: rgba(53, 132, 228, 0.8);
    border: 2px solid rgba(53, 132, 228, 0.8);
    border-radius: 10px;
}


#battery:hover {
    background-color: rgba(60, 60, 60, 0.3);
}
#battery.plugged:hover {
    background-color: rgba(60, 60, 60, 0.3);
}
#battery.charging:hover {
    background-color: rgba(60, 60, 60, 0.3);
}


