    "clock": {
      //"format": "<span foreground='#C6AAE8'> </span>{:%a %d %I:%M:%S %p}",
      "format": "<span foreground='#C6AAE8'></span>{:%a %d %I:%M:%S %p}",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "interval": 1
    },
    "custom/dspeed": {
        "exec": "~/.config/waybar/scripts/dspeed.sh",
        "format": "{}",
        "interval": 1
    },
    "custom/uspeed": {
        "exec": "~/.config/waybar/scripts/uspeed.sh",
        "format": "{}",
        "interval": 1
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false,
        "interval": 1
    },
    "custom/fan": {
        "exec": "~/.config/waybar/scripts/fan_speed.sh",
        "format": "{}",
        "interval": 7
    },
    "custom/media": {
        "exec": "~/.config/waybar/scripts/media.sh",
        "format": "{}",
        "interval": 7
    },
    "custom/ram": {
        "exec": "~/.config/waybar/scripts/ram.sh",
        "format": "{}",
        "interval": 7
    },
    "custom/ramperc": {
        "exec": "~/.config/waybar/scripts/ramperc.sh",
        "format": "{}",
        "interval": 7
    },
    //"custom/audio": {
