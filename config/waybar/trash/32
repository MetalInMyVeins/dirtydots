* {
    font-family: GE Inspira, FontAwesome, Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
    background-color: rgba(40, 40, 40, 0);
    padding: 0;
    margin: 0;
}

#clock {
    /*background: linear-gradient(45deg, #689d6a, #8ec07c);*/
    margin-right: 25px;
    color: #ebdbb2;
    background-size: 100% 100%;
    text-shadow: 0 0 5px rgba(0, 0, 0, 0.577);
    animation: gradient 20s ease infinite;
    font-size: 13px;
    padding-top: 2px;
    padding-right: 21px;
    font-weight: bolder;
    padding-left: 20px;
}


