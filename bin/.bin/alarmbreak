#!/usr/bin/env bash

pidfile="${XDG_RUNTIME_DIR:-/tmp}/move-reminder.pid"

if [[ -e "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    echo "already running"
    exit 1
fi

echo "$$" > "$pidfile"
trap 'rm -f "$pidfile"; exit 0' EXIT INT TERM HUP

while :; do
    sleep 545m
    notify-send "Exercise" "45 minutes passed, take a 5-min break and exercise."
    printf '\a'
done
