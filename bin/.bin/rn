#!/usr/bin/env bash
#
# rn - resolve and run a binary, either from a path argument
#      or from the first line of a file.
#
# Usage:
#   rn -f <file>   Read the first line of <file>, treat it as a path
#                  to a binary, and execute it.
#   rn -p <path>   Treat <path> as a literal binary path and execute it.

set -euo pipefail

usage() {
    echo "Usage: $0 -f <file> | -p <path> [-- args...]" >&2
    exit 1
}

resolve_and_exec() {
    local target="$1"
    shift

    # Expand a leading ~ manually since it won't be expanded
    # if it came from a variable/file rather than literal shell input.
    if [[ "$target" == "~"* ]]; then
        target="${target/#\~/$HOME}"
    fi

    if [[ -z "$target" ]]; then
        echo "rn: empty path, nothing to execute" >&2
        exit 1
    fi

    if [[ ! -e "$target" ]]; then
        echo "rn: no such file: $target" >&2
        exit 1
    fi

    if [[ ! -x "$target" ]]; then
        echo "rn: not executable: $target" >&2
        exit 1
    fi

    exec "$target" "$@"
}

[[ $# -ge 2 ]] || usage

mode="$1"
arg="$2"
shift 2 || true

# Anything left over is passed through as args to the target binary.
case "$mode" in
    -f)
        [[ -f "$arg" ]] || { echo "rn: no such file: $arg" >&2; exit 1; }
        first_line="$(head -n 1 -- "$arg")"
        resolve_and_exec "$first_line" "$@"
        ;;
    -p)
        resolve_and_exec "$arg" "$@"
        ;;
    *)
        usage
        ;;
esac
