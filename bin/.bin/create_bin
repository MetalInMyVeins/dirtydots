#!/bin/bash

main=$1

if [ "${main}" = "-h" ];
then
  echo "Usage: create_bin [main.cxx] [binary_name] [shared_library_path] [p..q..r..]<libp.so libq.so libr.so..>"
  exit 0
fi

name=$2
sopath=$3
shift 3
sos=("$@")
flagsos=""
compiler="clang++ -std=c++20"

for so in "${sos[@]}"
do
  flagsos="${flagsos} -l${so}"
done

${compiler} ${main} -o ${name} -L${sopath} ${flagsos} -static-libgcc -static-libstdc++ -Wl,-rpath=${sopath}


