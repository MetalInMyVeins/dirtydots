#!/bin/bash
# Copy Music from cloud to pc

tput setaf 4
echo "This script is going to tranfer data according to the diagram below:"
tput setaf 6
echo "Cloud     ---------->     PC"
tput setaf 4
echo "Folder: Music"
read -p "Confirmed to continue? (yes): " confirm && [[ $confirm == "yes" ]] || exit 1
tput setaf 6
rclone sync abdurrahim:Music ~/HDD/Media/Music -P


